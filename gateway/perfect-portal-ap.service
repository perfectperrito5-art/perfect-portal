[Unit]
Description=Perfect Portal Wi-Fi captive access point
Documentation=file:///home/admin_perfect/perfect_portal/gateway/README-AP.md
After=network-online.target NetworkManager.service
Wants=network-online.target
# If Docker is installed, start after it so FORWARD rules are not wiped later
After=docker.service
# Do not require Docker (machine may not have it)
Wants=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/admin_perfect/perfect_portal/gateway

# Give NetworkManager / DHCP a moment after boot
ExecStartPre=/home/admin_perfect/perfect_portal/gateway/wait-for-uplink.sh 60 2
ExecStart=/home/admin_perfect/perfect_portal/gateway/start-ap.sh
ExecStartPost=/home/admin_perfect/perfect_portal/gateway/ensure-forward.sh
ExecStop=/home/admin_perfect/perfect_portal/gateway/stop-ap.sh

TimeoutStartSec=180
TimeoutStopSec=60

# If start fails (Wi-Fi busy, etc.), try again a few times
Restart=on-failure
RestartSec=15

StandardOutput=journal
StandardError=journal
SyslogIdentifier=perfect-portal-ap

[Install]
WantedBy=multi-user.target