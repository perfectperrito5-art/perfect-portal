# Perfect Portal — network / AP settings
# Edit this file, then run: sudo ./gateway/start-ap.sh
#
# You choose the radios and the IPs. Nothing here is hardcoded in the app
# besides these values.

SSID="Perfect-WiFi"
# Leave empty for open network (easier captive-portal popup on phones).
# Or set e.g. WIFI_PASS="portal1234" for WPA2 (min 8 chars).
WIFI_PASS=""

# pc     = this computer IS the Wi-Fi access point (hostapd on LAN_IF)
# device = a hardware AP is the radio; this PC is portal + gateway only
AP_ROLE="device"

WAN_IF="wlp1s0"          # Ethernet toward the ISP router (internet)
LAN_IF="enp0s31f6"             # Customer side: PC Wi-Fi (pc:wlp1s0) or Ethernet to AP (device:enpXsY)
PORTAL_IP="192.168.3.1"    # IP of THIS SERVER on the customer network
PORTAL_NET="192.168.3.0/24"
DHCP_START="192.168.3.3"
DHCP_END="192.168.3.254"
PORTAL_PORT="5000"
CHANNEL="6"                 # used only when AP_ROLE=pc (2.4 GHz)
COUNTRY="TZ"

# Block internet until voucher/payment authorizes MAC
CAPTIVE_BLOCK="yes"

# Auto-start Flask portal with the AP
START_PORTAL="yes"
PORTAL_DIR="/home/admin_perfect/perfect_portal"
PORTAL_USER="admin_perfect"
