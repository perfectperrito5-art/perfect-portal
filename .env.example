# Flask
FLASK_ENV=production
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///instance/portal.db

# Public URL of this portal (used in Selcom webhooks / redirects)
PORTAL_BASE_URL=http://10.0.0.1:5000

# Clock shown to customers/admins (package time is stored in UTC seconds)
DISPLAY_TIMEZONE=Africa/Dar_es_Salaam

# Superuser bootstrap (created on first run if no admin exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisStrongPassword!

# Selcom API (get credentials from Selcom: info@selcom.net)
SELCOM_BASE_URL=https://apigw.selcommobile.com
SELCOM_API_KEY=
SELCOM_API_SECRET=
SELCOM_VENDOR=
SELCOM_WEBHOOK_SECRET=

# Captive gateway
# When true, authorize/revoke scripts under gateway/ are executed after payment
GATEWAY_ENABLED=false
GATEWAY_SCRIPT=/home/admin_perfect/perfect_portal/gateway/authorize.sh

# Security
SESSION_COOKIE_SECURE=false
WTF_CSRF_ENABLED=true
RATE_LIMIT_DEFAULT=120/hour